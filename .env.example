# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
API_MAX_IN_FLIGHT=64
WORKER_HEALTH_PORT=8002

# Database Configuration
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/console_api_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=console_api_db
DB_POOL_MAX=15
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

# Redis Configuration (required for background job processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Meta/Facebook Configuration
META_API_VERSION=v18.0
META_ACCESS_TOKEN=your_meta_access_token
META_BUSINESS_ID=your_business_id
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# WABA onboarding uses the configured META_ACCESS_TOKEN or an existing account credential.
# META_APP_ID/SECRET fall back to FACEBOOK_APP_ID/SECRET when the same app is shared.
META_APP_ID=
META_APP_SECRET=
# Stable base64-encoded 32-byte encryption key; may fall back to FACEBOOK_TOKEN_ENCRYPTION_KEY.
WABA_TOKEN_ENCRYPTION_KEY=
WABA_WEBHOOK_CALLBACK_URL=https://your-api.example.com/v1/webhooks/meta

# Application Configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000
MESSAGE_BATCH_SIZE=100
RATE_LIMIT_PER_MINUTE=100

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
API_KEY_SALT=your_api_key_salt

# Logging
LOG_LEVEL=debug

# Facebook Messenger (separate from WhatsApp; no Page tokens belong in this file)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set an active version supported by your App Dashboard, e.g. vXX.0.
FACEBOOK_GRAPH_VERSION=
FACEBOOK_LOGIN_MODE=business
# Facebook Login for Business configuration using a USER access token and only
# pages_show_list, pages_messaging, pages_manage_metadata. Classic is opt-in.
FACEBOOK_LOGIN_CONFIG_ID=
# Separate Facebook Login for Business configuration for Instant Forms / leads.
# Use a USER token, Page assets, and pages_show_list, pages_read_engagement,
# pages_manage_ads, leads_retrieval, pages_manage_metadata (plus Meta dependencies).
# Add /v1/facebook/leads/oauth/callback to Valid OAuth Redirect URIs.
FACEBOOK_LEADS_LOGIN_CONFIG_ID=
# Page posts: USER-token configuration with pages_show_list, pages_read_engagement,
# pages_read_user_content and pages_manage_posts. Add the exact redirect URL:
# https://YOUR-HOST/v1/facebook/posts/oauth/callback
FACEBOOK_PAGES_LOGIN_CONFIG_ID=
FACEBOOK_PAGES_LOGIN_MODE=business
# Business & Ads: separate USER-token configuration with business_management,
# ads_read, ads_management, pages_show_list and pages_read_engagement.
# Add /v1/facebook/ads/oauth/callback to Valid OAuth Redirect URIs.
FACEBOOK_ADS_LOGIN_CONFIG_ID=
FACEBOOK_ADS_LOGIN_MODE=business
# Marketing API versions can retire earlier than the shared Graph API version.
FACEBOOK_ADS_GRAPH_VERSION=v26.0
# Direct Instagram Login (Business or Creator account; no Facebook Page required).
# Use the Instagram App ID/Secret from Instagram > API setup with Instagram Login.
# Add /v1/facebook/instagram/oauth/callback to that product's redirect allowlist.
# Webhooks: /v1/facebook/instagram/webhook; subscribe to messages and comments.
# Direct OAuth also requests instagram_business_content_publish for photos and Reels.
INSTAGRAM_AUTH_PROVIDER=instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_PUBLIC_URL=https://support.example.com
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Optional persistent upload folder; defaults to uploads/.instagram-publishing.
INSTAGRAM_PUBLISH_UPLOAD_DIR=
# Optional Facebook Login alternative for a linked professional account.
# Separate USER-token configuration with instagram_basic, instagram_manage_messages,
# instagram_manage_comments, pages_show_list, pages_read_engagement, pages_manage_metadata.
# Add /v1/facebook/instagram/oauth/callback to Valid OAuth Redirect URIs.
INSTAGRAM_LOGIN_CONFIG_ID=1578273164075864
# business (default); classic is opt-in for apps configured for classic Facebook Login.
INSTAGRAM_LOGIN_MODE=business
# Optional saved test connection, encrypted using FACEBOOK_TOKEN_ENCRYPTION_KEY.
# Bind to one company owner and Page; never send this credential to the browser.
FACEBOOK_LEADS_PRESET_TOKEN_CIPHERTEXT=
FACEBOOK_LEADS_PRESET_COMPANY_ID=
FACEBOOK_LEADS_PRESET_OWNER_ID=
FACEBOOK_LEADS_PRESET_PAGE_ID=
FACEBOOK_LEADS_PRESET_PAGE_NAME=
FACEBOOK_PUBLIC_URL=https://support.example.com
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACEBOOK_TOKEN_ENCRYPTION_KEY=
FACEBOOK_PRIVACY_CONTROLLER=
FACEBOOK_PRIVACY_EMAIL=

# Standalone developer login page: npm run facebook:login (no database required).
# Uses FACEBOOK_APP_ID, FACEBOOK_APP_SECRET and FACEBOOK_GRAPH_VERSION above.
# Default tests public_profile with classic Facebook Login. For Login for Business,
# set business and configure FACEBOOK_LOGIN_CONFIG_ID to issue a USER token.
FACEBOOK_TEST_LOGIN_MODE=classic
FACEBOOK_TEST_PORT=8002
# Optional: your HTTPS tunnel origin, or http://localhost:8002 for standalone use.
# When blank, uses FACEBOOK_PUBLIC_URL if set, otherwise the local server origin.
FACEBOOK_TEST_PUBLIC_URL=

# Google Sheets integration. Register this exact callback as a Web OAuth redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ea13-2401-4900-8fea-1cc3-f8ac-28c8-9ea8-a7ab.ngrok-free.app/v1/integrations/google/callback
# Dashboard origin allowed to send credentials for the Google OAuth browser cookie.
GOOGLE_FRONTEND_URL=https://ea13-2401-4900-8fea-1cc3-f8ac-28c8-9ea8-a7ab.ngrok-free.app
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional: enables spreadsheet selection on the Google OAuth test page.
# Use a browser API key restricted to your test origin and Google Picker / Drive APIs.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Contacts / People API: independent authorization, never a Sheets Picker token.
# If omitted, derive the callback origin from GOOGLE_REDIRECT_URI and use GOOGLE_CLIENT_ID/SECRET.
GOOGLE_PEOPLE_REDIRECT_URI=
GOOGLE_PEOPLE_FRONTEND_URL=
GOOGLE_PEOPLE_CLIENT_ID=
GOOGLE_PEOPLE_CLIENT_SECRET=
# Optional separate stable key; otherwise reuse GOOGLE_TOKEN_ENCRYPTION_KEY with a different encryption context.
GOOGLE_PEOPLE_TOKEN_ENCRYPTION_KEY=
# true requires the account owner to save their own OAuth client credentials.
GOOGLE_PEOPLE_REQUIRE_CUSTOM_CLIENT=false

# Shopify standalone OAuth. Register the exact callback in the Shopify app.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://YOUR-API-HOST/v1/integrations/shopify/callback
SHOPIFY_FRONTEND_URL=https://YOUR-DASHBOARD-HOST
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2026-10
# Independent, stable 32-byte base64 encryption key; set the same value on all replicas.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_TEST_LOGIN_DOMAIN=
SHOPIFY_EVENT_RETENTION_DAYS=30
# Public company identity and privacy contact. The privacy page returns 503 until both are set.
SHOPIFY_PRIVACY_CONTROLLER=Soft7
SHOPIFY_PRIVACY_EMAIL=
# Optional export encryption tool; use a separate key kept in your hosting secret manager.
# This does not configure or encrypt your provider's automatic database backups.
SHOPIFY_BACKUP_ENCRYPTION_KEY=

# Separate automation flows. Use the backend origin, without /v1.
AUTOMATION_PUBLIC_BASE_URL=https://YOUR-API-HOST
# Optional: use the same queue name on API and worker to isolate local/shared-DB runs.
AUTOMATION_QUEUE_NAME=
# 32 random bytes encoded as base64. If omitted, the existing 64-hex payment
# gateway encryption key is used. Keep the selected key stable across releases.
AUTOMATION_ENCRYPTION_KEY=
# Optional login-domain hint for the diagnostic page (development defaults to localhost).
GOOGLE_TEST_LOGIN_DOMAIN=

# Backend-to-dashboard notification transport; use the private Kubernetes service.
WA_DASHBOARD_INTERNAL_URL=http://wa-dashboard-user:3000/internal/socket-emit
# Same random secret on the API, worker and dashboard. Never expose it to browsers.
SOCKET_EMIT_SECRET=
# Shared dashboard origins. Other origins must belong to the authenticated company.
SOCKET_SHARED_ORIGINS=https://app.soft7.in
