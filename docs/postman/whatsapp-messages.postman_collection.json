            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{recipient}}\",\n  \"type\": \"image\",\n  \"image\": {\n    \"link\": \"{{image_url}}\",\n    \"caption\": \"Your image\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "send"
              ]
            },
            "description": "Use a publicly accessible media URL for link, or an existing WhatsApp media ID for id. Supply only one of link or id. Replace the media variables before sending; these examples do not upload files."
