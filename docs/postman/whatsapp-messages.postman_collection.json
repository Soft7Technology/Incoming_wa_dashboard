    {
      "name": "Templates",
      "item": [
        {
          "name": "Send template without parameters",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{recipient}}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{template_name}}\",\n    \"language\": {\n      \"code\": \"{{template_language}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "send"
              ]
            },
            "description": "Use an approved template with no dynamic parameters; set its exact name and language."
          },
          "response": []
        },
        {
          "name": "Send template with body parameter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{recipient}}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{template_name}}\",\n    \"language\": {\n      \"code\": \"{{template_language}}\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{template_body_value}}\"\n          }\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "send"
              ]
            },
            "description": "Example for a template with one positional body parameter. Match parameter count, order and types to your approved template."
          },
          "response": []
        },
        {
