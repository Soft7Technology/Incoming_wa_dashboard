{
  "info": {
    "name": "WhatsApp Messages - User API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Messages only. Set base_url to your API root including /v1, without a trailing slash. Requests use /api/messages/send. Set phone_number_id to your connected sender, recipient to the full international number including country calling code, and user_api_key to your issued user API key (not a dashboard JWT or Meta token). Authentication: Authorization: Bearer {{user_api_key}}. Set secrets in a private Postman environment before use; exported files contain no credentials. Sending a request can send a real WhatsApp message. Media URL/ID examples do not upload files. Templates must match your approved template definition."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-api.example.com/v1",
      "type": "string"
    },
    {
      "key": "user_api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone_number_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "recipient",
      "value": "",
      "type": "string"
    },
    {
      "key": "media_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "image_url",
      "value": "https://your-domain.example/image.jpg",
      "type": "string"
    },
    {
      "key": "video_url",
      "value": "https://your-domain.example/video.mp4",
      "type": "string"
    },
    {
      "key": "document_url",
      "value": "https://your-domain.example/document.pdf",
      "type": "string"
    },
    {
      "key": "audio_url",
      "value": "https://your-domain.example/audio.mp3",
      "type": "string"
    },
    {
      "key": "sticker_url",
      "value": "https://your-domain.example/sticker.webp",
      "type": "string"
    },
    {
      "key": "template_name",
      "value": "",
      "type": "string"
    },
    {
      "key": "template_language",
      "value": "en",
      "type": "string"
    },
    {
      "key": "template_body_value",
      "value": "Customer",
      "type": "string"
    },
    {
      "key": "document_filename",
      "value": "document.pdf",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Text",
      "item": [
        {
          "name": "Send text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{recipient}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Hello! How can we help you?\",\n    \"preview_url\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages",
                "send"
              ]
            },
            "description": "Sends a text message using the authenticated user account. recipient must include its country calling code. API success is not proof of delivery."
          },
          "response": []
        }
      ]
    },
